# ---------------------------------------------------------------------------
# JutaOne.Biz — environment template. Copy to .env.local and fill in.
# Never commit real keys. Values below are placeholders only.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, hreflang and Chip redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Singapore region: ap-southeast-1) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS; only used inside API routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Meta AI (Llama API, OpenAI-compatible) ---------------------------------
# Leave META_AI_API_KEY empty to run on the local template generator.
META_AI_API_KEY=
META_AI_BASE_URL=https://api.llama.com/compat/v1
META_AI_MODEL=Llama-3.3-70B-Instruct
META_AI_TIMEOUT_MS=2500
# Used to estimate spend for the daily kill switch (USD per 1K tokens).
META_AI_COST_PER_1K_TOKENS=0.0006

# --- Chip.Asia (FPX / cards) ------------------------------------------------
CHIP_API_KEY=
CHIP_BRAND_ID=
CHIP_API_BASE_URL=https://gate.chip-in.asia/api/v1
# PEM public key from the Chip dashboard, used to verify webhook signatures.
CHIP_PUBLIC_KEY=
# Sandbox only: Chip requires a client email to create a purchase.
CHIP_TEST_EMAIL=sandbox@jutaone.biz

# --- Trial control & kill switch -------------------------------------------
# Free demo attempts per visitor (D3).
DEMO_MAX_ATTEMPTS=2
# Secondary cap per device fingerprint, blocks "new IP, same browser".
DEMO_DEVICE_MAX_ATTEMPTS=4
# Demo turns off automatically once today's AI spend reaches this (USD).
DAILY_API_COST_LIMIT_USD=50
# Set to 1 to stop the demo immediately, regardless of spend.
KILL_SWITCH_FORCE=0
# Salt for IP/device hashing. Use 32+ random characters in production.
VISITOR_HASH_SALT=change-me-to-a-long-random-string

# --- Local development helpers ---------------------------------------------
# Force a region instead of relying on Cloudflare headers: MY | ID | OTHER
# FORCE_REGION=MY
