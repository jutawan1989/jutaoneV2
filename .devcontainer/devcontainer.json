// .devcontainer/devcontainer.json — JutaOne Cloud: ROZIE + Interpreter, TERASING dari web Ali
// Pengerusi: Ayah | Strategi: Halwa | Eksekusi: Goses | 2026-10-30
// Mandat pengasingan: marketing di 8010/8011/8012; web Ali (80/443/3000/8080) TIDAK DISENTUH.
{
  "name": "JutaOne Cloud — ROZIE + Interpreter (zero-latency)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-playwright.playwright"]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8010, 8011, 8012],
  "portsAttributes": {
    "8010": { "label": "ROZIE Brain API (terasing, bukan port web Ali)", "onAutoForward": "notify" },
    "8011": { "label": "Interpreter UI (terasing)", "onAutoForward": "silent" },
    "8012": { "label": "Bukti/benchmark spare (terasing)", "onAutoForward": "silent" }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1",
    "PLAYWRIGHT_BROWSERS_PATH": "/home/vscode/.cache/ms-playwright",
    "ROZIE_MODE": "cloud",
    "ROZIE_API": "http://localhost:8010",
    "PORT_ROZIE": "8010",
    "PORT_INTERPRETER": "8011",
    "PORT_SPARE": "8012",
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/jutaone-marketing-ops/venv"
  }
}
