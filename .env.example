# ---------------------------------------------------------------------------
# JutaOne.Biz — environment template. Copy to .env.local and fill in.
# Never commit real keys. Values below are placeholders only.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, hreflang and Chip redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Singapore region: ap-southeast-1) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS; only used inside API routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Meta AI (Llama API, OpenAI-compatible) ---------------------------------
# Leave META_AI_API_KEY empty to run on the local template generator.
META_AI_API_KEY=
META_AI_BASE_URL=https://api.meta.ai/v1
# `muse-spark-1.3` is the non-contributor tier. The `-contributor` variants
# send prompts to training, so picking one is a PDPA/UU PDP decision, not a
# default.
META_AI_MODEL=muse-spark-1.3
META_AI_TIMEOUT_MS=3500
# Used to estimate spend for the daily kill switch (USD per 1K tokens).
META_AI_COST_PER_1K_TOKENS=0.0006

# --- OpenRouter (development phase: free, non-reasoning, zero cost) --------
# Tried before Meta: Meta currently answers 402 billing_not_configured.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free non-reasoning model: answers in 1.2-2.4s with reasoning disabled.
# Reasoning models (:free reasoning tiers) ignore OPENROUTER_REASONING and spend
# 650-1330 tokens thinking first, which pushes a caption past 9 seconds.
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# 240-character captions need ~120 tokens.
OPENROUTER_MAX_TOKENS=400
OPENROUTER_TIMEOUT_MS=8000
# `off` (default) sends reasoning:{enabled:false}. Set to `on` only for a model
# that rejects the flag or needs to think; a rejected flag is retried once
# automatically.
OPENROUTER_REASONING=off
# Set to 0 to drop straight back to the local template without removing the key.
OPENROUTER_ENABLED=1

# --- Chip.Asia (FPX / cards) ------------------------------------------------
CHIP_API_KEY=
CHIP_BRAND_ID=
CHIP_API_BASE_URL=https://gate.chip-in.asia/api/v1
# Optional: restrict checkout to specific methods (comma-separated, e.g.
# CHIP_PAYMENT_METHODS=fpx,visa,mastercard,duitnow_qr).
# Leave UNSET to offer every method the brand enables — including foreign
# Visa/Mastercard and DuitNow QR (Online), which Indonesian wallets (BCA,
# DANA, ShopeePay) use cross-border via the DuitNow-QRIS linkage.
# Valid names: fpx, fpx_b2b1, visa, mastercard, maestro, duitnow_qr, dnqr,
# razer_tng, razer_grabpay, razer_shopeepay, razer_maybankqr, razer_atome,
# shopee_pay, mpgs_apple_pay, mpgs_google_pay, crypto_coin.
CHIP_PAYMENT_METHODS=
# PEM public key from the Chip dashboard, used to verify webhook signatures.
# Callbacks are rejected when this is unset (fail closed).
CHIP_PUBLIC_KEY=
# Local testing only: accept unsigned callbacks. Never enable in production.
CHIP_ALLOW_UNSIGNED_CALLBACKS=0
# Sandbox only: Chip requires a client email to create a purchase.
CHIP_TEST_EMAIL=sandbox@jutaone.biz

# --- Trial control & kill switch -------------------------------------------
# Free demo attempts per visitor (D3).
DEMO_MAX_ATTEMPTS=2
# Secondary cap per device fingerprint, blocks "new IP, same browser".
DEMO_DEVICE_MAX_ATTEMPTS=4
# Demo turns off automatically once today's AI spend reaches this (USD).
DAILY_API_COST_LIMIT_USD=50
# Set to 1 to stop the demo immediately, regardless of spend.
KILL_SWITCH_FORCE=0
# Salt for IP/device hashing. Use 32+ random characters in production.
VISITOR_HASH_SALT=change-me-to-a-long-random-string

# --- Local development helpers ---------------------------------------------
# Force a region instead of relying on Cloudflare headers: MY | ID | OTHER
# FORCE_REGION=MY

# --- Biz-Match supplier directory ------------------------------------------
# OpenCorporates rejects anonymous calls with 401 on every endpoint, so a token
# is required before the adapter can import anything.
OPENCORPORATES_API_KEY=
# Jurisdiction to search; MY by default.
OPENCORPORATES_JURISDICTION=my

# --- Exa (Biz-Match semantic supplier search) ------------------------------
# Web search over suppliers. Without a key, /api/biz-match/search falls back to
# the supplier_directory table and reports degraded=exa_not_configured.
EXA_API_KEY=

# --- Groq (fallback 1: fastest provider, ~240ms measured) -------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# The models the brief named (llama-3.1-8b-instant / llama-3.3-70b-versatile)
# returned 404 "does not exist or you do not have access" on this account.
# gpt-oss-* are reasoning models whose budget is consumed by thinking, leaving
# content empty. qwen answers directly and is the default.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=400
# 8s aborted verbose generations; 20s gives each provider a real chance.
GROQ_TIMEOUT_MS=20000
GROQ_COST_PER_1K_TOKENS=0
GROQ_ENABLED=1

# --- OpenAI (fallback 2: gpt-4o-mini paid tier) ---------------------------
# Sits between Groq and OpenRouter: paid and reliable for when DeepSeek and
# Groq both fail, before the free OpenRouter tier. Same prompt builders as the
# other adapters, so BM/ID/EN rules are identical.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=400
OPENAI_TIMEOUT_MS=20000
# Blended USD per 1K total tokens (gpt-4o-mini list: $0.15/1M in + $0.60/1M out).
OPENAI_COST_PER_1K_TOKENS=0.00045
# Set to 0 to skip OpenAI without removing the key.
OPENAI_ENABLED=1

# --- DeepSeek (primary provider when configured) ---------------------------
# Platform key from platform.deepseek.com. NOT an OpenRouter or Groq key.
# Endpoint verified reachable: api.deepseek.com returns 401 for a bad key, so a
# missing key means the chain simply starts at Groq.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# `deepseek-chat` is the non-reasoning model. `deepseek-reasoner` would spend the
# token budget thinking first and truncate a short caption.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=400
DEEPSEEK_TIMEOUT_MS=20000
# USD per 1K tokens, used by the daily kill switch.
DEEPSEEK_COST_PER_1K_TOKENS=0.00027
# Set to 0 to skip DeepSeek without removing the key.
DEEPSEEK_ENABLED=1
