# ---------------------------------------------------------------------------
# JutaOne.Biz — environment template. Copy to .env.local and fill in.
# Never commit real keys. Values below are placeholders only.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, hreflang and Chip redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Singapore region: ap-southeast-1) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS; only used inside API routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin panel (internal testing gate) -------------------------------------
# Password for /admin/login and the /api/admin/* routes (manual top-up, payout).
# Minimum 12 characters — a shorter value disables the panel entirely.
# Production/staging: set as a Worker secret with
# `npx wrangler secret put ADMIN_TEST_PASSWORD` (never baked into the build).
# Local dev: put the value in .env.local (same file, never committed).
ADMIN_TEST_PASSWORD=

# --- Meta AI (Llama API, OpenAI-compatible) ---------------------------------
# Leave META_AI_API_KEY empty to run on the local template generator.
META_AI_API_KEY=
META_AI_BASE_URL=https://api.meta.ai/v1
# `muse-spark-1.3` is the non-contributor tier. The `-contributor` variants
# send prompts to training, so picking one is a PDPA/UU PDP decision, not a
# default.
META_AI_MODEL=muse-spark-1.3
META_AI_TIMEOUT_MS=3500
# Used to estimate spend for the daily kill switch (USD per 1K tokens).
META_AI_COST_PER_1K_TOKENS=0.0006

# --- OpenRouter (development phase: free, non-reasoning, zero cost) --------
# Tried before Meta: Meta currently answers 402 billing_not_configured.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free non-reasoning model: answers in 1.2-2.4s with reasoning disabled.
# Reasoning models (:free reasoning tiers) ignore OPENROUTER_REASONING and spend
# 650-1330 tokens thinking first, which pushes a caption past 9 seconds.
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# 240-character captions need ~120 tokens.
OPENROUTER_MAX_TOKENS=400
OPENROUTER_TIMEOUT_MS=8000
# `off` (default) sends reasoning:{enabled:false}. Set to `on` only for a model
# that rejects the flag or needs to think; a rejected flag is retried once
# automatically.
OPENROUTER_REASONING=off
# Set to 0 to drop straight back to the local template without removing the key.
OPENROUTER_ENABLED=1

# --- Chip.Asia (Store Rent ONLY — CLOSED for token top-up, Stripe only) -------
CHIP_API_KEY=
CHIP_BRAND_ID=
CHIP_API_BASE_URL=https://gate.chip-in.asia/api/v1
# Optional: restrict checkout to specific methods (comma-separated, e.g.
# CHIP_PAYMENT_METHODS=fpx,visa,mastercard,duitnow_qr).
# Leave UNSET to offer every method the brand enables — including foreign
# Visa/Mastercard and DuitNow QR (Online), which Indonesian wallets (BCA,
# DANA, ShopeePay) use cross-border via the DuitNow-QRIS linkage.
# Valid names: fpx, fpx_b2b1, visa, mastercard, maestro, duitnow_qr, dnqr,
# razer_tng, razer_grabpay, razer_shopeepay, razer_maybankqr, razer_atome,
# shopee_pay, mpgs_apple_pay, mpgs_google_pay, crypto_coin.
CHIP_PAYMENT_METHODS=
# PEM public key from the Chip dashboard, used to verify webhook signatures.
# Callbacks are rejected when this is unset (fail closed).
CHIP_PUBLIC_KEY=
# Local testing only: accept unsigned callbacks. Never enable in production.
CHIP_ALLOW_UNSIGNED_CALLBACKS=0
# Sandbox only: Chip requires a client email to create a purchase.
CHIP_TEST_EMAIL=sandbox@jutaone.biz

# --- Stripe (global cards, Test Mode while the secret key is sk_test_) -----
# Server-only. Test payments use card 4242 4242 4242 4242, no real charge.
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe dashboard (whsec_...). Callbacks are
# rejected when unset (fail closed); local testing can opt out with
# STRIPE_ALLOW_UNSIGNED_CALLBACKS=1 (never in production).
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_UNSIGNED_CALLBACKS=0
# Publishable key (pk_test_...) for any future client-side Stripe.js use.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Curlec (Razorpay) — Malaysia cards, MYR settlement, Test Mode ---------
# Server-only. An `rzp_test_...` key id IS Test Mode: orders created with it
# hit the same https://api.razorpay.com/v1/orders host but move no real
# money. Boss supplies the test keys; until then the adapter returns mock
# orders (same shape, local redirect), never a throw.
CURLEC_KEY_ID=
CURLEC_KEY_SECRET=
# Webhook signing secret from the Curlec/Razorpay dashboard. Callbacks are
# rejected when unset (fail closed); local testing can opt out with
# CURLEC_ALLOW_UNSIGNED_CALLBACKS=1 (never in production).
CURLEC_WEBHOOK_SECRET=
CURLEC_ALLOW_UNSIGNED_CALLBACKS=0

# --- Ad pixels (Lead Ads — IDs supplied by Boss later) -------------------------
# Each pixel renders only when its ID is set; empty = zero third-party
# requests. Public by design (pixels fire from the browser).
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# NEXT_PUBLIC_X_PIXEL_ID=

# --- Trial control & kill switch -------------------------------------------
# Free demo attempts per visitor (D3).
DEMO_MAX_ATTEMPTS=2
# Secondary cap per device fingerprint, blocks "new IP, same browser".
DEMO_DEVICE_MAX_ATTEMPTS=4
# Demo turns off automatically once today's AI spend reaches this (USD).
DAILY_API_COST_LIMIT_USD=50
# Set to 1 to stop the demo immediately, regardless of spend.
KILL_SWITCH_FORCE=0
# Salt for IP/device hashing. Use 32+ random characters in production.
VISITOR_HASH_SALT=change-me-to-a-long-random-string

# --- Local development helpers ---------------------------------------------
# Force a region instead of relying on Cloudflare headers: MY | ID | OTHER
# FORCE_REGION=MY

# --- Biz-Match supplier directory ------------------------------------------
# OpenCorporates rejects anonymous calls with 401 on every endpoint, so a token
# is required before the adapter can import anything.
OPENCORPORATES_API_KEY=
# Jurisdiction to search; MY by default.
OPENCORPORATES_JURISDICTION=my

# --- Exa (Biz-Match layer 1: semantic supplier search) -----------------------
# Web search over suppliers. Without a key, /api/biz-match/search falls back to
# the next layer and reports the provider error.
EXA_API_KEY=

# --- Tavily (Biz-Match layer 2: cheapest basic search) ---------------------
TAVILY_API_KEY=

# --- Serper.dev (Biz-Match layer 3: Google results) -------------------------
# POST https://google.serper.dev/search with the key in the X-API-KEY header.
# The adapter pins `gl`/`hl` per country (MY -> gl=my/hl=ms, ID -> gl=id/hl=id).
SERPER_API_KEY=

# --- Biz-Match provider order ----------------------------------------------
# Primary live provider: exa | tavily | serper. Default exa.
# Tried in order: primary first, then the other two, then the Supabase
# supplier_directory table (free fallback, never charged).
SEARCH_PROVIDER=exa

# --- Metals: Dual-API (homepage free, dashboard premium) ---------------------
# Task 1 — Goldprice.dev (FREE homepage feed, cached 4h):
# GET https://api.goldprice.dev/v1/prices?symbol=XAU-USD-SPOT&symbol=XAG-USD-SPOT
# with `Authorization: Bearer GOLDPR...KEY` (X-API-Key also accepted).
# USD is converted locally (MYR x4.70, IDR x16000). Key in Cloudflare Secrets.
GOLDPRICE_API_KEY=
# --- FX: RM-anchored checkout rates (src/lib/fx.ts) ---------------------------
# Static overrides, checked FIRST — an ops-set rate is never silently replaced
# by the drifting free feed. IDR value is rupiah-per-RM (e.g. 3600), USD value
# is dollars-per-RM (e.g. 0.2222). Leave UNSET to use the free live feed
# (open.er-api.com, no key, 6h cache) with built-in fallback (RM 1 = Rp 3,600).
FX_RM_TO_IDR=
FX_RM_TO_USD=
# Task 2 — Metal Sentinel via RapidAPI (PREMIUM dashboard analysis, 2,000 tokens):
# GET https://metal-sentinel.p.rapidapi.com/api/v1/{gold,silver}-price?currency=MYR
# with X-RapidAPI-Key + X-RapidAPI-Host headers. Key in Cloudflare Secrets.
RAPIDAPI_KEY=

# --- Groq (fallback 1: fastest provider, ~240ms measured) -------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# The models the brief named (llama-3.1-8b-instant / llama-3.3-70b-versatile)
# returned 404 "does not exist or you do not have access" on this account.
# gpt-oss-* are reasoning models whose budget is consumed by thinking, leaving
# content empty. qwen answers directly and is the default.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=400
# 8s aborted verbose generations; 20s gives each provider a real chance.
GROQ_TIMEOUT_MS=20000
GROQ_COST_PER_1K_TOKENS=0
GROQ_ENABLED=1

# --- OpenAI (cost-saving chain: paid reliable tier, after Gemini) -----------
# gpt-4o-mini sits after Gemini: paid and reliable before the local template.
# Same prompt builders as the other adapters, so BM/ID/EN rules are identical.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=400
OPENAI_TIMEOUT_MS=20000
# Blended USD per 1K total tokens (gpt-4o-mini list: $0.15/1M in + $0.60/1M out).
OPENAI_COST_PER_1K_TOKENS=0.00045
# Set to 0 to skip OpenAI without removing the key.
OPENAI_ENABLED=1

# --- Gemini (cost-saving chain: Groq -> OpenRouter -> Gemini -> OpenAI) -----
# Google's OpenAI-compatible endpoint. Model stays overridable.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=400
GEMINI_TIMEOUT_MS=20000
# Blended USD per 1K total tokens, used by the daily kill switch.
GEMINI_COST_PER_1K_TOKENS=0.0003
# Set to 0 to skip Gemini without removing the key.
GEMINI_ENABLED=1

# --- DeepSeek (REMOVED from the chain: cost decision) ------------------------
# The adapter file `src/lib/ai/deepseek.ts` is kept but unwired: nothing
# imports it, so a key here would be ignored. To restore, re-add the import +
# list entry in `src/lib/ai/index.ts` (and assistant.ts).
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=0

# --- ToyyibPay (CLOSED — MY top-up now routes to Stripe) -----------------------
# CLOSED: kept for the legacy `/api/topup/toyyib-callback` route only.
# New top-ups always go through Stripe (`/api/topup`).
# Get both values from the ToyyibPay dashboard (Settings). Sandbox testing:
# point the adapter at dev.toyyibpay.com with TOYYIBPAY_USE_SANDBOX=1 and
# sandbox credentials. Runtime secret on the Worker via
# `wrangler secret put TOYYIBPAY_SECRET_KEY` (never baked into the build).
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
# Set to 1 only for sandbox testing against dev.toyyibpay.com.
TOYYIBPAY_USE_SANDBOX=

# --- RapidAPI Shopee + TikTok scrapers (auto-import product image) --------
# Shopee: best-shopee-scraper-free-1000-calls
#   GET /products/details?product={url}
#   NOTE: this vendor only serves the SG catalogue — MY/ID product links 404
#   "not found". Short links are resolved server-side before the call, but a
#   Malaysia-only product still needs an SG-listed equivalent or the OG fallback.
# TikTok: tiktok-shop-scraper-api1
#   POST { urls: [...] } to one of (first 2xx with image wins):
#     /api/v2/tiktok-shop/products/search/suggestions
#     /v2/shop/products
#     /v2/tiktok-shop/products/search/suggestions
#   Both 429-proven (path exists, quota hit) while 40+ others 404.
#   429 = stop for the hour, fall to OG. Set RAPIDAPI_TIKTOK_PATHS=/real
#   to lock one path (comma-separated for fallbacks).
# Runtime secrets on the Worker via `wrangler secret put RAPIDAPI_KEY`
# (never baked into the build). Hosts are overridable for vendor changes.
RAPIDAPI_KEY=
RAPIDAPI_SHOPEE_HOST=best-shopee-scraper-free-1000-calls.p.rapidapi.com
RAPIDAPI_TIKTOK_HOST=tiktok-shop-scraper-api1.p.rapidapi.com
RAPIDAPI_TIKTOK_PATHS=

# --- Customer Service WhatsApp (official numbers, Boss spec 31 Okt 2026) ---
# Public by design: these bake into wa.me links in the browser bundle.
# Never commit real secrets here — these are public contact numbers only.
# Malaysia (BM/EN) and Indonesia (ID); invalid values fall back to the
# Boss-specified numbers in src/lib/contact.ts.
NEXT_PUBLIC_SUPPORT_WA_MY=601149655880
NEXT_PUBLIC_SUPPORT_WA_ID=6287892768208
