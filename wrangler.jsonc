{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jutaonev2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  // Required: the API routes use node:crypto for hashing and RSA verification.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // NEXT_PUBLIC_SITE_URL is intentionally NOT set here: it is inlined at build
  // time by Next.js, so a copy in this file would silently drift from the value
  // used to build canonical URLs, hreflang, robots.txt and sitemap.xml.
  // Set it in .env.local (or the deploy shell) instead, and confirm the real
  // workers.dev URL after the first deploy.
}
