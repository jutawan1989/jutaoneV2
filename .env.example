# ---------------------------------------------------------------------------
# JutaOne.Biz — environment template. Copy to .env.local and fill in.
# Never commit real keys. Values below are placeholders only.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, hreflang and Chip redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Singapore region: ap-southeast-1) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS; only used inside API routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Meta AI (Llama API, OpenAI-compatible) ---------------------------------
# Leave META_AI_API_KEY empty to run on the local template generator.
META_AI_API_KEY=
META_AI_BASE_URL=https://api.meta.ai/v1
# `muse-spark-1.3` is the non-contributor tier. The `-contributor` variants
# send prompts to training, so picking one is a PDPA/UU PDP decision, not a
# default.
META_AI_MODEL=muse-spark-1.3
META_AI_TIMEOUT_MS=3500
# Used to estimate spend for the daily kill switch (USD per 1K tokens).
META_AI_COST_PER_1K_TOKENS=0.0006

# --- OpenRouter (development phase: free, non-reasoning, zero cost) --------
# Tried before Meta: Meta currently answers 402 billing_not_configured.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free non-reasoning model: answers in 1.2-2.4s with reasoning disabled.
# Reasoning models (:free reasoning tiers) ignore OPENROUTER_REASONING and spend
# 650-1330 tokens thinking first, which pushes a caption past 9 seconds.
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# 240-character captions need ~120 tokens.
OPENROUTER_MAX_TOKENS=400
OPENROUTER_TIMEOUT_MS=8000
# `off` (default) sends reasoning:{enabled:false}. Set to `on` only for a model
# that rejects the flag or needs to think; a rejected flag is retried once
# automatically.
OPENROUTER_REASONING=off
# Set to 0 to drop straight back to the local template without removing the key.
OPENROUTER_ENABLED=1

# --- Chip.Asia (FPX / cards) ------------------------------------------------
CHIP_API_KEY=
CHIP_BRAND_ID=
CHIP_API_BASE_URL=https://gate.chip-in.asia/api/v1
# PEM public key from the Chip dashboard, used to verify webhook signatures.
# Callbacks are rejected when this is unset (fail closed).
CHIP_PUBLIC_KEY=
# Local testing only: accept unsigned callbacks. Never enable in production.
CHIP_ALLOW_UNSIGNED_CALLBACKS=0
# Sandbox only: Chip requires a client email to create a purchase.
CHIP_TEST_EMAIL=sandbox@jutaone.biz

# --- Trial control & kill switch -------------------------------------------
# Free demo attempts per visitor (D3).
DEMO_MAX_ATTEMPTS=2
# Secondary cap per device fingerprint, blocks "new IP, same browser".
DEMO_DEVICE_MAX_ATTEMPTS=4
# Demo turns off automatically once today's AI spend reaches this (USD).
DAILY_API_COST_LIMIT_USD=50
# Set to 1 to stop the demo immediately, regardless of spend.
KILL_SWITCH_FORCE=0
# Salt for IP/device hashing. Use 32+ random characters in production.
VISITOR_HASH_SALT=change-me-to-a-long-random-string

# --- Local development helpers ---------------------------------------------
# Force a region instead of relying on Cloudflare headers: MY | ID | OTHER
# FORCE_REGION=MY

# --- Biz-Match supplier directory ------------------------------------------
# OpenCorporates rejects anonymous calls with 401 on every endpoint, so a token
# is required before the adapter can import anything.
OPENCORPORATES_API_KEY=
# Jurisdiction to search; MY by default.
OPENCORPORATES_JURISDICTION=my
